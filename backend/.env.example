# ---- Server ----
PORT=3000

# Komma-gescheiden oorsprongen die mogen posten (frontend op GitHub Pages)
CORS_ORIGIN=https://hornyhousewives.eu

# ---- SMTP (standaard: lokale Postfix op dezelfde server) ----
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
# Alleen invullen als je een smarthost/relay met inlog gebruikt:
SMTP_USER=
SMTP_PASS=

# ---- E-mail ----
DOMAIN=hornyhousewives.eu
FROM_ADDRESS=no-reply@hornyhousewives.eu
RECIPIENT=lisa@hornyhousewives.eu
